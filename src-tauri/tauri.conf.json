{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pikonativeminer",
  "version": "0.1.13",
  "identifier": "com.piko.nativeminer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "pikonativeminer",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDRDA4MUY1RkE4NDUxOUIKUldTYlVZVDY5WUhRckZVeUVmSUd0QnIxMmVZMzl4QUxZS2JaV0lWR1lnNWE2NFZOWTdRMGorOS8K",
      "endpoints": [
        "https://github.com/icpbuilder01/pikonativeminer/releases/latest/download/latest.json"
      ]
    }
  }
}
