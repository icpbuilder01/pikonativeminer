{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pikonativeminer",
  "version": "0.1.12",
  "identifier": "com.piko.nativeminer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "pikonativeminer",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBOEFDMTlFMTkxOUUzRDgKUldUWTR4a1puc0dLbWkyUW1tdHdHYzEvT0YxQU9lQ2kxZWhmc1Zwa203Lzh5Qkx0VktpSnJEbW0K",
      "endpoints": [
        "https://github.com/icpbuilder01/pikonativeminer/releases/latest/download/latest.json"
      ]
    }
  }
}
